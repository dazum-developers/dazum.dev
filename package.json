{
  "name": "maple",
  "version": "1.0.0",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier packages/**/* --cache --write",
    "lint": "eslint -c eslint.config.mjs  packages/**",
    "lint:fix": "yarn run lint --fix",
    "prepare": "husky",
    "start": "bun --filter maple-api start"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-canonical": "^44.3.40",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-sonarjs": "^3.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.22.0"
  }
}
